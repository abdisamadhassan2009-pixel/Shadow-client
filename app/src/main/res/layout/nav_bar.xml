<?xml version="1.0" encoding="utf-8"?>
<!-- Ghost Client: Dawn-style left icon rail. Every id and view type matches the
     original top bar so BaseActivity / Settings / Personalization keep working. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_bar_root"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dawn_rail"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="68dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/nav_back_button"
            android:layout_width="36dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:rotation="90"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_down"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/nav_logo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_ghost_logo" />

        <TextView
            android:id="@+id/nav_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misans"
            android:text="@string/app_name"
            android:textColor="#F2F4F8"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nav_tab_launch"
                    android:layout_width="58dp"
                    android:layout_height="54dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_dawn_rail_tab"
                    android:drawableTop="@drawable/ic_nav_launch"
                    android:drawablePadding="2dp"
                    android:fontFamily="@font/misans"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:singleLine="true"
                    android:text="@string/nav_launch"
                    android:textColor="@color/on_surface"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nav_tab_instances"
                    android:layout_width="58dp"
                    android:layout_height="54dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_dawn_rail_tab"
                    android:drawableTop="@drawable/ic_nav_instances"
                    android:drawablePadding="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/misans"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:singleLine="true"
                    android:text="@string/nav_instances"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/nav_tab_about"
                    android:layout_width="58dp"
                    android:layout_height="54dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_dawn_rail_tab"
                    android:drawableTop="@drawable/ic_nav_about"
                    android:drawablePadding="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/misans"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:singleLine="true"
                    android:text="@string/nav_about"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/nav_tab_settings"
                    android:layout_width="58dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_dawn_rail_tab"
                    android:drawableTop="@drawable/ic_nav_settings"
                    android:drawablePadding="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/misans"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:singleLine="true"
                    android:text="@string/nav_settings"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </ScrollView>

        <FrameLayout
            android:id="@+id/nav_news_container"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/news_title"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_news_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/news_title"
                android:src="@drawable/ic_nav_news"
                app:tint="@color/text_secondary" />

            <View
                android:id="@+id/nav_news_badge"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_news_unread_dot"
                android:visibility="gone" />
        </FrameLayout>

        <Button
            android:id="@+id/nav_sign_in_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="58dp"
            android:layout_height="34dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="@color/primary"
            android:fontFamily="@font/misans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="2dp"
            android:paddingVertical="0dp"
            android:singleLine="true"
            android:text="@string/sign_in"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/nav_account_avatar_container"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <com.microsoft.xbox.idp.toolkit.CircleImageView
                android:id="@+id/nav_account_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/xbox_avatar"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_minecraft_cube" />

            <ProgressBar
                android:id="@+id/nav_avatar_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:id="@+id/nav_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/divider" />

</LinearLayout>
